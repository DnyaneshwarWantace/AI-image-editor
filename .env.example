# Database
DATABASE_URL="your_database_url_here"

# =====================================
# AI API Keys (for Layer Extraction)
# =====================================

# Google Cloud Vision API (Text Detection)
# Get your API key: https://console.cloud.google.com/apis/credentials
# Free tier: 1,000 requests/month
# Required for: Best quality text detection with exact bounding boxes
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Gemini API Key (Nano Banana image generation/editing)
# Get your API key: https://aistudio.google.com/apikey
# Required for: Prompt-based background fill using gemini-2.5-flash-image
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI mode (USE THIS to consume your $300 Google Cloud credits)
# 1) Enable Vertex AI API on your project
# 2) Run: gcloud auth application-default login
# 3) Set these variables:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Replicate API (LaMa inpainting + optional SAM segmentation)
# Get your token: https://replicate.com/account/api-tokens
# Required for: Background generation (LaMa inpainting) and optional object segmentation (SAM)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Remove.bg API (Background Removal - current implementation)
# Get your key: https://www.remove.bg/api
# Required for: Removing backgrounds from images
# Note: This will be replaced by SAM in the new architecture
REMOVE_BG_API_KEY=your_removebg_api_key_here

# NOTE: "Nano Banana" is just Gemini image generation (gemini-2.5-flash-image)
# No separate API key needed - uses GEMINI_API_KEY above for:
# - Extracting objects as transparent PNGs
# - Generating clean backgrounds (removing text/objects and filling)

# App URL (for callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================
# Optional / Legacy
# =====================================

# OCR.space API (Fallback text detection)
# Only used if Google Vision API fails
# Get your key: https://ocr.space/ocrapi
NEXT_PUBLIC_OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Inpaint API URL (Override)
# Override the default inpainting endpoint if needed
# NEXT_PUBLIC_INPAINT_API_URL=https://your-custom-inpaint-endpoint.com/api/inpaint
